{
    "compilerOptions": {
        "target": "ES2017",
        "module": "none",
        "lib": ["ES2017", "DOM"],
        "strict": false,
        "outDir": ".",
        "rootDir": ".",
        "declaration": false,
        "sourceMap": false,
        "skipLibCheck": true,
        "noEmit": false
    },
    "include": [
        "index.ts",
        "隐藏楼层/index.ts",
        "types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
